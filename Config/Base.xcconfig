// Shared build settings. Secrets are optional so the project builds without a key.
#include? "../Secrets.xcconfig"

LLM_API_KEY = $(LLM_API_KEY)
LLM_BASE_URL = $(LLM_BASE_URL)
LLM_MODEL = $(LLM_MODEL)
GEMINI_API_KEY = $(GEMINI_API_KEY)
GEMINI_BASE_URL = $(GEMINI_BASE_URL)
GEMINI_MODEL = $(GEMINI_MODEL)
MYNETDIARY_API_KEY = $(MYNETDIARY_API_KEY)
MYNETDIARY_BASE_URL = $(MYNETDIARY_BASE_URL)
MYNETDIARY_USER_ID = $(MYNETDIARY_USER_ID)

// Unique reverse-DNS id so Automatic Signing can register an App ID on a free or paid team.
// Change this if Xcode still says the identifier is unavailable.
PRODUCT_BUNDLE_IDENTIFIER = com.elyaskhoubach.wuhu
MARKETING_VERSION = 1.0
CURRENT_PROJECT_VERSION = 1
SWIFT_VERSION = 5.0
IPHONEOS_DEPLOYMENT_TARGET = 18.0
TARGETED_DEVICE_FAMILY = 1,2
ENABLE_USER_SCRIPT_SANDBOXING = YES
CLANG_ENABLE_MODULES = YES
CODE_SIGN_STYLE = Automatic
