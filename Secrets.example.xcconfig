// Copy to Secrets.xcconfig and fill in real values.
// Secrets.xcconfig is git-ignored and must never be committed.

// OpenAI-compatible API key (optional — app falls back to local scoring without it)
LLM_API_KEY = your_api_key_here

// Base URL for chat completions (OpenAI-compatible)
LLM_BASE_URL = https:/$()/api.openai.com/v1

// Model id pinned for consistent scores
LLM_MODEL = gpt-4o-mini

// Gemini chat (Google AI Studio or Antigravity → Get API key). Leave the placeholder to use local chat fallback.
GEMINI_API_KEY = your_gemini_api_key_here
// Optional overrides. Empty values use the defaults in GeminiConfiguration.swift.
// AQ.* and AIza* keys both use this host (not Vertex aiplatform.googleapis.com unless you intentionally switch).
GEMINI_BASE_URL = https:/$()/generativelanguage.googleapis.com/v1beta
// As of 2026, new projects often require gemini-3.8-flash; older docs may list gemini-2.0-flash (404).
GEMINI_MODEL = gemini-3.8-flash

// MyNetDiary. Leave the key empty to use Apple Health dietary energy instead.
// Personal diary access is not a public API. This key is only for a partner or proxy
// that serves GET /v1/diary/days. Do not commit Secrets.xcconfig.
MYNETDIARY_API_KEY = your_mynetdiary_api_key_here
MYNETDIARY_BASE_URL = https:/$()/api.mynetdiary.com
MYNETDIARY_USER_ID =
